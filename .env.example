PORT=3000
NODE_ENV=development

# TCP (default). Set MYSQL_PASSWORD to the real MySQL user password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# Ubuntu/local: if root only works via sudo mysql, use socket auth instead:
# Comment out MYSQL_HOST / MYSQL_PORT above is optional; socket wins when set.
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock

MYSQL_DATABASE=student_collab

# At least 16 characters (required).
JWT_SECRET=change-this-to-a-long-random-string-in-production
# Optional, e.g. 7d, 24h, 3600 (seconds)
# JWT_EXPIRES_IN=7d

# Allow POST /api/admin/bootstrap in production (default: off)
# ALLOW_ADMIN_BOOTSTRAP=true
